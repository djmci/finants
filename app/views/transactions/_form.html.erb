<%= form_with model: txn, class: "space-y-4" do |f| %>
  <div class="grid grid-cols-2 gap-3">
    <div class="fieldset">
      <%= f.label :posted_on, "Date", class: "label" %>
      <%= f.date_field :posted_on, required: true, class: "input w-full" %>
    </div>
    <div class="fieldset">
      <%= f.label :direction, "Type", class: "label" %>
      <%= f.select :direction, options_for_select([ [ "Spent", "expense" ], [ "Received", "income" ] ], txn.persisted? ? txn.direction : "expense"), {}, name: "transaction[direction]", class: "select w-full" %>
    </div>
  </div>
  <div class="fieldset">
    <%= f.label :amount, class: "label" %>
    <%= f.number_field :amount, value: txn.persisted? ? txn.amount.abs : nil, step: "0.01", min: "0.01", required: true, autofocus: true, class: "input w-full" %>
  </div>
  <div class="fieldset">
    <%= f.label :payee, class: "label" %>
    <%= f.text_field :payee, class: "input w-full", placeholder: "Who was paid / who paid you" %>
  </div>
  <div class="fieldset">
    <%= f.label :account_id, "Account", class: "label" %>
    <%= f.collection_select :account_id, accounts, :id, :name, {}, class: "select w-full" %>
  </div>
  <div class="fieldset">
    <%= f.label :category_id, "Category", class: "label" %>
    <%= f.collection_select :category_id, categories, :id, :display_name, { include_blank: "Uncategorised" }, class: "select w-full" %>
  </div>
  <div class="fieldset">
    <%= f.label :notes, class: "label" %>
    <%= f.text_area :notes, rows: 2, class: "textarea w-full" %>
  </div>
  <% if txn.transfer? %>
    <p class="text-xs text-base-content/60">Part of a transfer — edits apply to this side only.</p>
  <% end %>
  <%= f.submit txn.persisted? ? "Save transaction" : "Add transaction", class: "btn btn-primary w-full" %>
  <% if txn.persisted? %>
    <%= button_to "Delete", transaction_path(txn), method: :delete, class: "btn btn-ghost btn-sm w-full text-error", data: { turbo_confirm: txn.transfer? ? "Delete both sides of this transfer?" : "Delete this transaction?" } %>
  <% end %>
<% end %>
