<% content_for :title, "Finants" %>

<div class="space-y-4">
  <div class="flex items-center justify-between flex-wrap gap-2">
    <h1 class="font-bold text-xl">Dashboard</h1>
    <% if @uncategorised_count.positive? %>
      <%= link_to transactions_path(uncategorised: 1), class: "btn btn-warning btn-sm btn-soft" do %>
        <%= @uncategorised_count %> uncategorised transactions
      <% end %>
    <% end %>
  </div>

  <div class="stats stats-vertical sm:stats-horizontal card card-border bg-base-100 w-full">
    <% @health.each do |name, h| %>
      <div class="stat">
        <div class="stat-title"><%= name %> — <%= h[:date].strftime("%-d %b %Y") %></div>
        <div class="stat-value text-2xl <%= h[:end_cents].negative? ? "text-error" : "" %>"><%= signed_money h[:end_cents] %></div>
        <div class="stat-desc"><%= signed_money h[:delta] %> from today</div>
      </div>
    <% end %>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body gap-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Cashflow forecast<%= " — #{@scoped_account.name}" if @scoped_account %></h2>
        <div class="flex items-center gap-1">
          <%= form_with url: root_path, method: :get, local: true, class: "flex items-center gap-1" do %>
            <%= hidden_field_tag :months, @months %>
            <%= select_tag :account, options_for_select(
                  [ [ "Cashflow (all liquid)", "" ] ] + @liquid.map { |a| [ a.name, a.id ] },
                  params[:account]),
                onchange: "this.form.requestSubmit()", class: "select select-sm w-52" %>
          <% end %>
          <div class="join">
            <% [ 3, 6, 12 ].each do |m| %>
              <%= link_to "#{m}mo", root_path(months: m, account: params[:account]),
                  class: "join-item btn btn-sm #{@months == m ? "btn-brand" : ""}" %>
            <% end %>
          </div>
        </div>
      </div>
      <%= render "balance_chart", history: @history, projection: @projection %>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
        <span class="text-base-content/70">Projected <%= @projection.last&.first&.strftime("%-d %b %Y") %>: <strong><%= signed_money(@projection.last&.last || 0) %></strong></span>
        <span class="text-base-content/70">Lowest point: <strong class="<%= "text-error" if @floor && @floor.last.negative? %>"><%= signed_money(@floor&.last || 0) %></strong> on <%= @floor&.first&.strftime("%-d %b %Y") %></span>
        <span class="text-base-content/70">Net cashflow: <strong class="<%= @net_flow.negative? ? "text-error" : "text-success" %>"><%= signed_money(@net_flow) %>/mo</strong> <span class="text-xs">(recurring + historical spend)</span></span>
      </div>
    </div>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body p-0">
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-2.5">
        <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Upcoming — next 30 days</h2>
        <%= link_to "Recurring rules", recurring_rules_path, class: "link link-hover text-xs" %>
      </div>
      <table class="table table-sm">
        <tbody>
          <% @upcoming.each do |occ| %>
            <tr>
              <td class="whitespace-nowrap text-base-content/70 w-28"><%= occ[:on].strftime("%a %-d %b") %></td>
              <td class="font-medium"><%= occ[:rule].payee %><% if occ[:rule].kind == "transfer" || occ[:rule].settle? %> <span class="badge badge-ghost badge-xs">→ <%= occ[:rule].to_account&.name %></span><% end %></td>
              <td class="hidden sm:table-cell text-base-content/70"><%= occ[:rule].account.name %></td>
              <td class="text-right"><%= occ[:rule].settle? ? content_tag(:span, "balance", class: "text-xs text-base-content/60") : signed_money(occ[:rule].signed_amount_cents) %></td>
            </tr>
          <% end %>
          <% if @upcoming.empty? %>
            <tr><td class="text-center text-base-content/50 py-6">Nothing due — add recurring rules for bills and paydays.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <% @liquid.each do |account| %>
      <%= link_to account_path(account), class: "card card-border bg-base-100 hover:bg-base-200/50 transition-colors" do %>
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <span class="font-medium"><%= account.name %></span>
            <span class="badge badge-soft badge-xs"><%= account.kind %></span>
          </div>
          <div class="flex items-end justify-between">
            <span class="text-2xl font-semibold"><%= money account.balance_cents %></span>
            <span class="text-xs text-base-content/50"><%= account.owner_label %></span>
          </div>
        </div>
      <% end %>
    <% end %>
    <% if @liquid.empty? %>
      <div class="card card-border bg-base-100 sm:col-span-2 lg:col-span-3">
        <div class="card-body items-center text-center py-10">
          <%= ant_icon size: 40 %>
          <p class="text-base-content/60">No cash accounts yet — <%= link_to "add one", accounts_path(new: 1), class: "link link-primary" %> to start tracking.</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
