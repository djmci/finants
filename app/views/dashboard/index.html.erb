<% content_for :title, "Finants" %>

<div class="space-y-4">
  <div class="flex items-center justify-between flex-wrap gap-2">
    <h1 class="font-bold text-xl">Dashboard</h1>
    <% if @uncategorised_count.positive? %>
      <%= link_to transactions_path(uncategorised: 1), class: "btn btn-warning btn-sm btn-soft" do %>
        <%= @uncategorised_count %> uncategorised transactions
      <% end %>
    <% end %>
  </div>

  <div class="stats stats-vertical sm:stats-horizontal card card-border bg-base-100 w-full">
    <div class="stat">
      <div class="stat-title">Cash on hand — <%= Date.current.strftime("%-d %b %Y") %></div>
      <div class="stat-value text-2xl"><%= signed_money @cash_now %></div>
      <div class="stat-desc">across <%= pluralize(@liquid.size, "liquid account") %></div>
    </div>
    <% @health.each do |name, h| %>
      <div class="stat">
        <div class="stat-title"><%= name %> — <%= h[:date].strftime("%-d %b %Y") %></div>
        <div class="stat-value text-2xl <%= { critical: "text-error", warn: "text-warning", ok: "" }[h[:severity]] %>"><%= signed_money h[:end_cents] %></div>
        <div class="stat-desc"><%= signed_money h[:delta] %> from today</div>
      </div>
    <% end %>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body p-0">
      <div class="flex items-center justify-between border-b border-base-300 px-4 py-2.5">
        <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Alerts</h2>
        <details class="dropdown dropdown-end">
          <summary class="btn btn-ghost btn-xs">Thresholds</summary>
          <div class="dropdown-content card card-border bg-base-100 z-10 w-64 p-3 shadow">
            <%= form_with url: settings_path, method: :patch, class: "space-y-2" do %>
              <div class="fieldset">
                <label class="label text-xs">Warn below ($)</label>
                <%= number_field_tag :alert_warn, @alert_warn, step: "0.01", class: "input input-sm w-full" %>
              </div>
              <div class="fieldset">
                <label class="label text-xs">Critical below ($)</label>
                <%= number_field_tag :alert_critical, @alert_critical, step: "0.01", class: "input input-sm w-full" %>
              </div>
              <%= submit_tag "Save", class: "btn btn-primary btn-sm w-full" %>
            <% end %>
          </div>
        </details>
      </div>
      <table class="table table-sm">
        <tbody>
          <% @breaches.each do |b| %>
            <tr>
              <td class="w-24"><span class="badge badge-soft badge-xs <%= b.severity == :critical ? "badge-error" : "badge-warning" %>"><%= b.severity %></span></td>
              <td>Cash below <%= money Setting.alert_warn_cents %>
                from <strong><%= b.from.strftime("%-d %b %Y") %></strong><%= " → #{b.through.strftime("%-d %b %Y")}" if b.through != b.from %></td>
              <td class="text-right text-base-content/70">lowest <strong class="text-error"><%= signed_money b.min %></strong> on <%= b.min_date.strftime("%-d %b") %></td>
            </tr>
          <% end %>
          <% if @breaches.empty? %>
            <tr><td class="text-center text-base-content/50 py-6">No breaches projected over the next 12 months.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% if @smoothing.any? %>
        <div class="border-t border-base-300 px-4 py-2.5 space-y-1">
          <h3 class="text-xs uppercase tracking-wide text-base-content/50 font-semibold">Smooth it out</h3>
          <% @smoothing.each do |s| %>
            <p class="text-sm text-base-content/80">
              Move <strong><%= s[:rule].payee %></strong> (<%= money s[:amount_cents] %>, currently <%= s[:on].strftime("%-d %b") %>)
              to <strong><%= s[:suggested].strftime("%-d %b") %></strong> — lands just after payday, right now it hits
              <%= (s[:trough] - s[:on]).to_i %> days before cash bottoms on <%= s[:trough].strftime("%-d %b") %>.
            </p>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body gap-3">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <h2 class="font-semibold text-sm uppercase tracking-wide text-base-content/60">Forecast<%= " — #{@scoped_account.name}" if @scoped_account %></h2>
        <div class="flex items-center gap-1">
          <%= form_with url: root_path, method: :get, local: true, class: "flex items-center gap-1" do %>
            <%= hidden_field_tag :months, @months %>
            <%= hidden_field_tag :basis, @basis %>
            <%= select_tag :account, options_for_select(
                  [ [ "Cashflow", "" ] ] + @accounts.map { |a| [ a.name, a.id ] },
                  params[:account]),
                onchange: "this.form.requestSubmit()", class: "select select-sm w-52" %>
          <% end %>
          <div class="join">
            <% { rules: "Best case", hybrid: "Most likely" }.each do |b, label| %>
              <%= link_to label, root_path(basis: b, months: @months, account: params[:account]),
                  class: "join-item btn btn-sm #{@basis == b ? "btn-brand" : ""}", title: { rules: "Only the items in your Forecast list", hybrid: "Your list, plus real-life spend it doesn't cover" }[b] %>
            <% end %>
          </div>
          <div class="join">
            <% [ 3, 6, 12 ].each do |m| %>
              <%= link_to "#{m}mo", root_path(months: m, account: params[:account], basis: @basis),
                  class: "join-item btn btn-sm #{@months == m ? "btn-brand" : ""}" %>
            <% end %>
          </div>
        </div>
      </div>
      <%= render "balance_chart", history: @history, projection: @projection %>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm">
        <span class="text-base-content/70">Projected <%= @projection.last&.first&.strftime("%-d %b %Y") %>: <strong><%= signed_money(@projection.last&.last || 0) %></strong></span>
        <span class="text-base-content/70">Lowest point: <strong class="<%= "text-error" if @floor && @floor.last.negative? %>"><%= signed_money(@floor&.last || 0) %></strong> on <%= @floor&.first&.strftime("%-d %b %Y") %></span>
        <span class="text-base-content/70">Ongoing rate: <strong class="<%= @net_flow.negative? ? "text-error" : "text-success" %>"><%= signed_money(@net_flow) %>/mo</strong> <span class="text-xs">(trend slope — ignores one-time hits like the card payoff)</span></span>
      </div>
      <% if @drift_categories.any? %>
        <p class="text-xs text-base-content/50">
          Unexplained spend last 90d:
          <% @drift_categories.first(4).each_with_index do |(name, cents), i| %><%= ", " if i.positive? %><%= name %> <%= signed_money(cents) %>/day<% end %><% if @drift_categories.size > 4 %>, +<%= @drift_categories.size - 4 %> more<% end %>
          — everything else is a rule.
        </p>
      <% end %>
    </div>
  </div>

  <div class="card card-border bg-base-100">
    <div class="card-body p-0">
      <div class="flex items-center justify-between border-b border-base-300 px-1">
        <div role="tablist" class="tabs tabs-border flex-nowrap">
          <%= link_to "Upcoming", root_path(basis: @basis, months: @months, account: params[:account]), role: "tab",
              class: "tab py-2 whitespace-nowrap #{@upcoming_view == "list" ? "tab-active" : ""}" %>
          <%= link_to "Calendar", root_path(basis: @basis, months: @months, account: params[:account], upcoming: "calendar"), role: "tab",
              class: "tab py-2 whitespace-nowrap #{@upcoming_view == "calendar" ? "tab-active" : ""}" %>
        </div>
        <%= link_to "Recurring rules", recurring_rules_path, class: "link link-hover text-xs pr-3" %>
      </div>
      <% if @upcoming_view == "list" %>
      <table class="table table-sm">
        <tbody>
          <% @upcoming.each do |occ| %>
            <tr>
              <td class="whitespace-nowrap text-base-content/70 w-28"><%= occ[:on].strftime("%a %-d %b") %></td>
              <td class="font-medium"><%= occ[:rule].payee %><% if occ[:rule].kind == "transfer" || occ[:rule].settle? %> <span class="badge badge-ghost badge-xs">→ <%= occ[:rule].to_account&.name %></span><% end %></td>
              <td class="hidden sm:table-cell text-base-content/70"><%= occ[:rule].account.name %></td>
                            <% amt = occ[:rule].settle? ? @settle_amounts[[occ[:rule].id, occ[:on]]] : nil %>
              <td class="text-right"><%= amt ? signed_money(-amt) : (occ[:rule].settle? ? content_tag(:span, "balance", class: "text-xs text-base-content/60") : signed_money(occ[:rule].signed_amount_cents)) %></td>
            </tr>
          <% end %>
          <% if @upcoming.empty? %>
            <tr><td class="text-center text-base-content/50 py-6">Nothing due — add recurring rules for bills and paydays.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>

      <% if @upcoming_view == "calendar" %>
        <div class="flex items-center justify-between px-4 py-2 border-b border-base-300">
          <%= link_to "← #{(@cal_month - 1.month).strftime("%b")}", root_path(basis: @basis, months: @months, account: params[:account], upcoming: "calendar", cal_month: (@cal_month - 1.month).strftime("%Y-%m")), class: "btn btn-ghost btn-xs" %>
          <h2 class="font-semibold text-sm"><%= @cal_month.strftime("%B %Y") %></h2>
          <%= link_to "#{(@cal_month + 1.month).strftime("%b")} →", root_path(basis: @basis, months: @months, account: params[:account], upcoming: "calendar", cal_month: (@cal_month + 1.month).strftime("%Y-%m")), class: "btn btn-ghost btn-xs" %>
        </div>
        <div class="overflow-x-auto">
        <div class="grid grid-cols-7 text-center text-xs text-base-content/50 border-b border-base-300 min-w-[640px]">
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |d| %><div class="py-1.5"><%= d %></div><% end %>
        </div>
        <div class="grid grid-cols-7 min-w-[640px]">
          <% (@cal_month.beginning_of_week..@cal_month.end_of_month.end_of_week).each do |day| %>
            <div class="min-h-24 border-t border-l border-base-300 first:border-l-0 p-1.5 <%= "bg-base-200/40 text-base-content/30" if day.month != @cal_month.month %>">
              <div class="text-xs <%= "font-bold" if day == Date.current %>"><%= day.day %></div>
              <% (@cal_days[day] || []).each do |o| %>
                <% settle_amt = o[:rule].settle? ? @settle_amounts[[o[:rule].id, day]] : nil %>
                <div class="text-[10px] leading-tight truncate <%= o[:rule].kind == "income" ? "text-success" : "text-error/80" %>"
                     title="<%= "#{o[:rule].payee} #{number_to_currency((o[:rule].settle? ? -(settle_amt || 0) : o[:rule].signed_amount_cents) / 100.0)}" %>">
                  <%= o[:rule].payee.truncate(12) %>
                  <% if o[:rule].settle? %>
                    <%= settle_amt ? number_to_currency(-settle_amt / 100.0) : "bal" %>
                  <% else %>
                    <%= number_to_currency(o[:rule].signed_amount_cents / 100.0) %>
                  <% end %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <% @liquid.each do |account| %>
      <%= link_to account_path(account), class: "card card-border bg-base-100 hover:bg-base-200/50 transition-colors" do %>
        <div class="card-body p-4">
          <div class="flex items-center justify-between">
            <span class="font-medium"><%= account.name %></span>
            <span class="badge badge-soft badge-xs"><%= account.kind %></span>
          </div>
          <div class="flex items-end justify-between">
            <span class="text-2xl font-semibold"><%= money account.balance_cents %></span>
            <span class="text-xs text-base-content/50"><%= account.owner_label %></span>
          </div>
        </div>
      <% end %>
    <% end %>
    <% if @liquid.empty? %>
      <div class="card card-border bg-base-100 sm:col-span-2 lg:col-span-3">
        <div class="card-body items-center text-center py-10">
          <%= ant_icon size: 40 %>
          <p class="text-base-content/60">No cash accounts yet — <%= link_to "add one", accounts_path(new: 1), class: "link link-primary" %> to start tracking.</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
