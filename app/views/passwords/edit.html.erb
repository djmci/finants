<% content_for :title, "Update password — Finants" %>

<div class="w-full max-w-sm">
  <div class="flex items-center justify-center gap-2 mb-4">
    <%= ant_icon size: 32 %>
    <%= finants_wordmark class: "font-bold text-2xl tracking-tight" %>
  </div>
  <div class="card card-border bg-base-100">
    <div class="card-body">
    <p class="text-sm text-base-content/60">Update your password</p>

    <% if alert = flash[:alert] %>
      <div class="alert alert-error mt-2"><span><%= alert %></span></div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-4 mt-2" do |form| %>
      <div class="fieldset">
        <%= form.label :password, "New password", class: "label" %>
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
      </div>
      <div class="fieldset">
        <%= form.label :password_confirmation, "Repeat new password", class: "label" %>
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input w-full" %>
      </div>
      <%= form.submit "Save", class: "btn btn-primary w-full" %>
    <% end %>
    </div>
  </div>
</div>
