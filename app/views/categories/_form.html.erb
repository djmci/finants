<%= form_with model: category, class: "space-y-4" do |f| %>
  <div class="fieldset">
    <%= f.label :name, class: "label" %>
    <%= f.text_field :name, required: true, autofocus: true, class: "input w-full" %>
  </div>
  <div class="fieldset">
    <%= f.label :kind, class: "label" %>
    <%= f.select :kind, Category::KINDS.map { |k| [ k.humanize, k ] }, {}, class: "select w-full" %>
  </div>
  <div class="fieldset">
    <%= f.label :parent_id, "Parent (optional)", class: "label" %>
    <%= f.collection_select :parent_id, parents, :id, :display_name, { include_blank: "None" }, class: "select w-full" %>
    <p class="text-xs text-base-content/50 mt-1">Subcategories must match their parent's kind.</p>
  </div>
  <label class="flex items-start gap-2 cursor-pointer">
    <%= f.check_box :exclude_from_forecast, class: "checkbox checkbox-sm mt-0.5" %>
    <span class="text-sm">One-off spend <span class="text-base-content/50">— excluded from forecast drift (e.g. a holiday)</span></span>
  </label>
  <%= f.submit category.persisted? ? "Save category" : "Add category", class: "btn btn-primary w-full" %>
<% end %>
