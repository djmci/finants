<% content_for :title, "Categories — Finants" %>
<% mobile_nav "categories", categories_path %>
<% content_for :mobile_action do %>
  <label for="category-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> Add</label>
<% end %>

<% editing = @edit_category.present? %>
<% editing_rule = @edit_rule.present? %>
<div class="drawer drawer-end">
  <input id="category-drawer" type="checkbox" class="drawer-toggle" data-controller="drawer-open" data-drawer-open-open-value="<%= editing || params[:new].present? %>" />
  <input id="rule-drawer" type="checkbox" class="drawer-toggle" data-controller="drawer-open" data-drawer-open-open-value="<%= editing_rule || params[:new_rule].present? %>" />

  <div class="drawer-content space-y-4">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="font-bold text-xl">Categories</h1>
      <% if @tab == "rules" %>
        <label for="rule-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> New rule</label>
      <% elsif editing %>
        <%= link_to categories_path(new: 1, tab: @tab), class: "btn btn-primary btn-sm" do %><%= icon "plus" %> New category<% end %>
      <% else %>
        <label for="category-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> New category</label>
      <% end %>
    </div>

    <div class="card card-border bg-base-100 overflow-x-auto">
      <div class="border-b border-base-300 px-4">
        <div role="tablist" class="tabs tabs-border flex-nowrap">
          <% %w[expense income rules].each do |tab| %>
            <%= link_to tab.humanize, categories_path(tab:), role: "tab",
                        class: "tab py-2 whitespace-nowrap #{@tab == tab ? "tab-active" : ""}" %>
          <% end %>
        </div>
      </div>

    <% if @tab == "rules" %>
      <p class="text-xs text-base-content/50 px-4 pt-2">Matched on ref-stripped payee text. "Auto" rules apply silently on import; the rest only fill the suggestion pills on History.</p>
      <table class="table table-sm">
          <tbody>
            <% @payee_rules.each do |rule| %>
              <tr class="hover:bg-base-200/50">
                <td class="font-mono text-xs"><%= rule.pattern.truncate(60) %></td>
                <td>
                  <% unless rule.round_amount.nil? %><span class="badge badge-ghost badge-xs"><%= rule.round_amount ? "round" : "non-round" %></span><% end %>
                  <% if rule.max_amount_cents %><span class="badge badge-ghost badge-xs">≤<%= money(rule.max_amount_cents) %></span><% end %>
                  <% if rule.direction %><span class="badge badge-ghost badge-xs"><%= rule.direction %> only</span><% end %>
                </td>
                <td><span class="badge badge-soft badge-xs"><%= rule.category.display_name %></span></td>
                <td class="text-base-content/60 text-xs"><%= rule.auto? ? "auto" : "suggest" %></td>
                <td class="text-right whitespace-nowrap w-20">
                  <div class="flex items-center justify-end">
                    <%= link_to categories_path(tab: "rules", edit_rule: rule.id), class: "btn btn-ghost btn-circle btn-sm", title: "Edit" do %><%= icon "edit", class: "size-4" %><% end %>
                    <%= button_to payee_rule_path(rule), method: :delete, class: "btn btn-ghost btn-circle btn-sm text-error", title: "Delete" do %><%= icon "trash", class: "size-4" %><% end %>
                  </div>
                </td>
              </tr>
            <% end %>
            <% if @payee_rules.empty? %>
              <tr><td colspan="5" class="text-center text-base-content/50 py-6">No rules yet — categorise a transaction and one is learned automatically.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <table class="table">
          <tbody>
            <% @grouped[@tab].each do |parent, subs| %>
              <tr class="hover:bg-base-200/50">
                <td class="font-medium">
                  <% if parent.colour.present? %><span class="inline-block size-2.5 rounded-full mr-1.5 align-middle" style="background: <%= parent.colour %>"></span><% end %>
                  <%= parent.name %>
                </td>
                <td class="text-base-content/60"><%= parent.transactions.size %> txns</td>
                <td class="text-right whitespace-nowrap w-24">
                  <div class="flex items-center justify-end">
                    <% if parent.active? %>
                      <%= button_to archive_category_path(parent), class: "btn btn-ghost btn-circle btn-sm", title: "Archive" do %><%= icon "archive", class: "size-4" %><% end %>
                    <% else %>
                      <%= button_to unarchive_category_path(parent), class: "btn btn-ghost btn-circle btn-sm", title: "Restore" do %><%= icon "unarchive", class: "size-4" %><% end %>
                    <% end %>
                    <%= link_to categories_path(edit: parent.id, tab: @tab), class: "btn btn-ghost btn-circle btn-sm", title: "Edit" do %><%= icon "edit", class: "size-4" %><% end %>
                  </div>
                </td>
              </tr>
              <% subs.each do |sub| %>
                <tr class="hover:bg-base-200/50">
                  <td class="pl-8 text-base-content/80"><%= sub.name %></td>
                  <td class="text-base-content/60"><%= sub.transactions.size %> txns</td>
                  <td class="text-right whitespace-nowrap w-24">
                    <div class="flex items-center justify-end">
                      <%= link_to categories_path(edit: sub.id, tab: @tab), class: "btn btn-ghost btn-circle btn-sm", title: "Edit" do %><%= icon "edit", class: "size-4" %><% end %>
                    </div>
                  </td>
                </tr>
              <% end %>
            <% end %>
            <% if @grouped[@tab].empty? %>
              <tr><td colspan="3" class="text-center text-base-content/50 py-6">No <%= @tab %> categories yet.</td></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="drawer-side z-50">
    <label for="category-drawer" aria-label="close drawer" class="drawer-overlay"></label>
    <div class="bg-base-100 min-h-full w-full sm:w-96 p-5 border-l border-base-300 overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg"><%= editing ? "Edit category" : "New category" %></h2>
        <label for="category-drawer" class="btn btn-ghost btn-sm btn-square" aria-label="Close">✕</label>
      </div>
      <%= render "form", category: @edit_category || Category.new, parents: @parents %>
    </div>
  </div>

  <div class="drawer-side z-50">
    <label for="rule-drawer" aria-label="close drawer" class="drawer-overlay"></label>
    <div class="bg-base-100 min-h-full w-full sm:w-96 p-5 border-l border-base-300 overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg"><%= editing_rule ? "Edit rule" : "New rule" %></h2>
        <label for="rule-drawer" class="btn btn-ghost btn-sm btn-square" aria-label="Close">✕</label>
      </div>
      <%= render "rule_form", rule: @edit_rule || PayeeRule.new %>
    </div>
  </div>
</div>
