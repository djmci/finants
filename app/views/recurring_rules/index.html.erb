<% content_for :title, "Forecast — Finants" %>
<% mobile_nav "repeat", recurring_rules_path %>
<% content_for :mobile_action do %>
  <label for="rule-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> Add</label>
<% end %>

<% editing = @edit_rule.present? %>
<div class="drawer drawer-end">
  <input id="rule-drawer" type="checkbox" class="drawer-toggle" data-controller="drawer-open" data-drawer-open-open-value="<%= editing || params[:new].present? %>" />

  <div class="drawer-content space-y-4">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <h1 class="font-bold text-xl">Forecast</h1>
      <% if editing %>
        <%= link_to recurring_rules_path(new: 1), class: "btn btn-primary btn-sm" do %><%= icon "plus" %> New rule<% end %>
      <% else %>
        <label for="rule-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> New rule</label>
      <% end %>
    </div>

    <div class="card card-border bg-base-100 overflow-x-auto">
      <div class="flex items-center border-b border-base-300 px-1">
        <div role="tablist" class="tabs tabs-border flex-nowrap">
          <%= link_to "Calendar", recurring_rules_path(tab: "calendar"), role: "tab",
              class: "tab py-2 whitespace-nowrap #{@tab == "calendar" ? "tab-active" : ""}" %>
          <%= link_to "Active", recurring_rules_path, role: "tab",
              class: "tab py-2 whitespace-nowrap #{@tab == "active" ? "tab-active" : ""}" %>
          <%= link_to "Paused", recurring_rules_path(tab: "paused"), role: "tab",
              class: "tab py-2 whitespace-nowrap #{@tab == "paused" ? "tab-active" : ""}" %>
          <%= link_to "Detected", recurring_rules_path(tab: "detected"), role: "tab",
              class: "tab py-2 whitespace-nowrap #{@tab == "detected" ? "tab-active" : ""}" %>
        </div>
      </div>
      <% if %w[active paused].include?(@tab) %>
      <table class="table">
        <thead>
          <tr class="text-xs text-base-content/50"><th>Payee</th><th class="hidden sm:table-cell">Account</th><th>Schedule</th><th class="hidden sm:table-cell">Category</th><th class="text-right">Amount</th><th class="hidden sm:table-cell">Next</th><th class="w-20"></th></tr>
        </thead>
        <tbody>
          <% @rules.each do |rule| %>
            <tr class="hover:bg-base-200/50">
              <td class="font-medium"><%= rule.payee %><% if rule.kind == "transfer" || rule.settle? %> <span class="badge badge-ghost badge-xs">→ <%= rule.to_account&.name %></span><% end %></td>
              <td class="hidden sm:table-cell text-base-content/70"><%= rule.account.name %></td>
              <td class="text-base-content/70"><%= rule.human_schedule %><% if rule.end_on %> <span class="text-xs">until <%= rule.end_on.strftime("%-d %b %Y") %></span><% end %></td>
              <td class="hidden sm:table-cell"><% if rule.category %><span class="badge badge-soft badge-xs"><%= rule.category.display_name %></span><% end %></td>
              <td class="text-right"><%= rule.settle? ? content_tag(:span, "full balance", class: "text-xs text-base-content/60") : signed_money(rule.signed_amount_cents) %></td>
              <td class="hidden sm:table-cell text-base-content/70"><%= @next[rule.id]&.strftime("%-d %b") || "—" %></td>
              <td class="text-right whitespace-nowrap w-20">
                <div class="flex items-center justify-end">
                  <% if rule.active? %>
                    <%= button_to archive_recurring_rule_path(rule), class: "btn btn-ghost btn-circle btn-sm", title: "Pause" do %><%= icon "pause", class: "size-4" %><% end %>
                  <% else %>
                    <%= button_to unarchive_recurring_rule_path(rule), class: "btn btn-ghost btn-circle btn-sm", title: "Resume" do %><%= icon "play", class: "size-4" %><% end %>
                  <% end %>
                  <%= link_to recurring_rules_path(edit: rule.id, tab: @tab), class: "btn btn-ghost btn-circle btn-sm", title: "Edit" do %>
                    <%= icon "edit", class: "size-4" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @rules.empty? %>
            <tr><td colspan="7" class="text-center text-base-content/50 py-8">No <%= @tab == "paused" ? "paused" : "active" %> rules yet — add your bills and paydays here.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% end %>

      <% if @tab == "detected" %>
        <% if @suggestions&.any? %>
        <table class="table">
          <thead>
            <tr class="text-xs text-base-content/50"><th>Payee</th><th class="hidden sm:table-cell">Account</th><th>Pattern</th><th class="text-right">Amount</th><th class="hidden sm:table-cell">Seen</th><th class="w-20"></th></tr>
          </thead>
          <tbody>
            <% @suggestions.each do |s| %>
              <tr class="hover:bg-base-200/50">
                <td class="font-medium max-w-64 truncate"><%= s[:payee] %></td>
                <td class="hidden sm:table-cell text-base-content/70"><%= @accounts_by_id[s[:account_id]]&.name %></td>
                <td class="text-base-content/70">~every <%= s[:frequency] == "monthly" && s[:every] > 1 ? "#{s[:every]} months" : s[:frequency] %></td>
                <td class="text-right"><%= signed_money s[:amount_cents] %></td>
                <td class="hidden sm:table-cell text-base-content/70"><%= s[:count] %>×, last <%= s[:last_on].strftime("%-d %b") %></td>
                <td class="text-right w-20">
                  <%= link_to recurring_rules_path(new: 1, prefill: {
                        payee: s[:payee].truncate(40), account_id: s[:account_id],
                        kind: s[:kind], amount: s[:amount_cents].abs / 100.0,
                        frequency: s[:frequency], every: s[:every], start_on: s[:next_on]
                      }), class: "btn btn-primary btn-soft btn-xs" do %>Add<% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <% else %>
          <p class="text-center text-base-content/50 py-8">Nothing detected — needs more history.</p>
        <% end %>
      <% end %>

      <% if @tab == "calendar" %>
        <div class="flex items-center justify-between px-4 py-2 border-b border-base-300">
          <%= link_to "← #{(@cal_month - 1.month).strftime("%b")}", recurring_rules_path(tab: "calendar", month: (@cal_month - 1.month).strftime("%Y-%m")), class: "btn btn-ghost btn-xs" %>
          <h2 class="font-semibold text-sm"><%= @cal_month.strftime("%B %Y") %></h2>
          <%= link_to "#{(@cal_month + 1.month).strftime("%b")} →", recurring_rules_path(tab: "calendar", month: (@cal_month + 1.month).strftime("%Y-%m")), class: "btn btn-ghost btn-xs" %>
        </div>
        <div class="grid grid-cols-7 text-center text-xs text-base-content/50 border-b border-base-300">
          <% %w[Mon Tue Wed Thu Fri Sat Sun].each do |d| %><div class="py-1.5"><%= d %></div><% end %>
        </div>
        <div class="grid grid-cols-7">
          <% (@cal_month.beginning_of_week..@cal_month.end_of_month.end_of_week).each do |day| %>
            <div class="min-h-28 border-t border-l border-base-300 first:border-l-0 p-1.5 <%= "bg-base-200/40 text-base-content/30" if day.month != @cal_month.month %>">
              <div class="text-xs <%= "font-bold" if day == Date.current %>"><%= day.day %></div>
              <% (@cal_days[day] || []).each do |o| %>
                <div class="text-[10px] leading-tight truncate <%= o[:rule].kind == "income" ? "text-success" : "text-error/80" %>"
                     title="<%= o[:rule].payee %> <%= signed_money(o[:rule].signed_amount_cents) %>">
                  <%= o[:rule].payee.truncate(12) %> <%= o[:rule].settle? ? "bal" : signed_money(o[:rule].signed_amount_cents) %>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
      </div>

  <div class="drawer-side z-50">
    <label for="rule-drawer" aria-label="close drawer" class="drawer-overlay"></label>
    <div class="bg-base-100 min-h-full w-full sm:w-96 p-5 border-l border-base-300 overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg"><%= editing ? "Edit rule" : "New rule" %></h2>
        <label for="rule-drawer" class="btn btn-ghost btn-sm btn-square" aria-label="Close">✕</label>
      </div>
      <%= render "form", rule: @edit_rule || @new_rule || RecurringRule.new(start_on: Date.current, frequency: "monthly", kind: "expense"), accounts: @accounts, categories: @categories %>
    </div>
  </div>
</div>
