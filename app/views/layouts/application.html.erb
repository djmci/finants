<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Finants" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Finants">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-base-200 text-base-content flex flex-col">
    <% if authenticated? %>
      <div class="navbar bg-base-100 border-b border-base-300">
        <div class="flex-1 flex items-center gap-4">
          <%= link_to root_path, class: "flex items-center gap-2" do %>
            <%= ant_icon size: 28 %>
            <%= finants_wordmark class: "font-bold text-xl tracking-tight" %>
          <% end %>
          <nav class="hidden sm:flex items-center gap-1 ml-4">
            <%= link_to "Transactions", transactions_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "Accounts", accounts_path, class: "btn btn-ghost btn-sm" %>
            <%= link_to "Categories", categories_path, class: "btn btn-ghost btn-sm" %>
          </nav>
        </div>
        <div class="flex-none">
          <%= link_to session_path, data: { turbo_method: :delete }, class: "btn btn-ghost btn-sm" do %>
            Sign out
          <% end %>
        </div>
      </div>
      <main class="flex-1 p-4 sm:p-6 lg:p-8 max-w-6xl w-full mx-auto">
        <%= yield %>
      </main>
    <% else %>
      <main class="flex-1 flex items-center justify-center p-4">
        <%= yield %>
      </main>
    <% end %>
    <footer class="footer footer-center border-t border-base-300 bg-base-100 p-4 text-sm text-base-content/60">
      <aside class="flex items-center gap-1.5">
        <%= ant_icon size: 14 %>
        <p>
          Finants — a
          <a href="https://redant.com.au" target="_blank" rel="noreferrer" class="link link-hover font-medium text-base-content/80">Red Ant</a>
          experiment,
          <span class="whitespace-nowrap">built with AI.</span>
        </p>
      </aside>
    </footer>
  </body>
</html>
