<% content_for :title, "#{@account.name} — Finants" %>
<% mobile_nav "accounts", accounts_path %>
<% content_for :mobile_action do %>
  <label for="txn-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> Add</label>
<% end %>

<% editing_txn = @edit_txn.present? %>
<div class="drawer drawer-end">
  <input id="txn-drawer" type="checkbox" class="drawer-toggle" data-controller="drawer-open" data-drawer-open-open-value="<%= editing_txn || params[:new].present? %>" />

  <div class="drawer-content space-y-4">
    <div class="flex items-center justify-between flex-wrap gap-2">
      <div class="flex items-center gap-3">
        <%= link_to accounts_path, class: "btn btn-ghost btn-sm btn-square", title: "Back to accounts" do %><%= icon "chevron-left" %><% end %>
        <h1 class="font-bold text-xl"><%= @account.name %></h1>
        <span class="badge badge-soft badge-xs"><%= @account.kind %></span>
        <span class="text-sm text-base-content/60"><%= @account.owner_label %></span>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-lg font-semibold"><%= money @account.balance_cents %></span>
        <% active_filters = params.values_at(:q, :uncategorised).count(&:present?) %>
        <label for="filter-drawer" class="btn btn-ghost btn-sm">Filters<%= " (#{active_filters})" if active_filters.positive? %></label>
        <label for="txn-drawer" class="btn btn-primary btn-sm"><%= icon "plus" %> Transaction</label>
      </div>
    </div>

    <div class="card card-border bg-base-100 overflow-x-auto">
      <table class="table">
        <thead>
          <tr class="text-xs text-base-content/50"><th>Date</th><th>Payee</th><th class="hidden sm:table-cell">Category</th><th class="text-right">Amount</th><th class="text-right hidden sm:table-cell">Balance</th><th class="w-20"></th></tr>
        </thead>
        <tbody>
          <% @transactions.each do |txn| %>
            <tr class="hover:bg-base-200/50">
              <td class="whitespace-nowrap text-base-content/70"><%= txn.posted_on.strftime("%-d %b %Y") %></td>
              <td>
                <span class="font-medium"><%= txn.payee.presence || "—" %></span>
                <% if txn.transfer? %><span class="badge badge-ghost badge-xs ml-1">transfer</span><% end %>
              </td>
              <td class="hidden sm:table-cell">
                <% if txn.category %>
                  <span class="badge badge-soft badge-xs"><%= txn.category.display_name %></span>
                <% else %>
                  <span class="badge badge-warning badge-soft badge-xs">uncategorised</span>
                <% end %>
              </td>
              <td class="text-right"><%= signed_money txn.amount_cents %></td>
              <td class="text-right hidden sm:table-cell text-base-content/70"><%= money @balances[txn.id] %></td>
              <td class="text-right whitespace-nowrap w-20">
                <div class="flex items-center justify-end">
                  <%= link_to account_path(@account, edit: txn.id, q: params[:q], uncategorised: params[:uncategorised], page: params[:page]), class: "btn btn-ghost btn-circle btn-sm", title: "Edit" do %>
                    <%= icon "edit", class: "size-4" %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
          <% if @transactions.empty? %>
            <tr><td colspan="6" class="text-center text-base-content/50 py-8">No transactions<%= params[:uncategorised].present? ? " to categorise" : " yet" %>.</td></tr>
          <% end %>
        </tbody>
      </table>
      <% if @pages > 1 %>
        <div class="flex items-center justify-between px-4 py-2.5 border-t border-base-300">
          <% params_page = params.permit(:q, :uncategorised) %>
          <% if @page > 1 %>
            <%= link_to "← Newer", account_path(@account, params_page.merge(page: @page - 1)), class: "btn btn-ghost btn-sm" %>
          <% else %>
            <span></span>
          <% end %>
          <span class="text-xs text-base-content/50">Page <%= @page %> of <%= @pages %></span>
          <% if @page < @pages %>
            <%= link_to "Older →", account_path(@account, params_page.merge(page: @page + 1)), class: "btn btn-ghost btn-sm" %>
          <% else %>
            <span></span>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="drawer-side z-50">
    <label for="txn-drawer" aria-label="close drawer" class="drawer-overlay"></label>
    <div class="bg-base-100 min-h-full w-full sm:w-96 p-5 border-l border-base-300 overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg"><%= editing_txn ? "Edit transaction" : "New transaction" %></h2>
        <label for="txn-drawer" class="btn btn-ghost btn-sm btn-square" aria-label="Close">✕</label>
      </div>
      <%= render "transactions/form", txn: @edit_txn || Transaction.new(account: @account, posted_on: Date.current), accounts: @accounts, categories: @categories, once_rules: @once_rules %>
    </div>
  </div>
</div>

<div class="drawer drawer-end">
  <input id="filter-drawer" type="checkbox" class="drawer-toggle" />
  <div class="drawer-side z-50">
    <label for="filter-drawer" aria-label="close drawer" class="drawer-overlay"></label>
    <div class="bg-base-100 min-h-full w-full sm:w-80 p-5 border-l border-base-300 overflow-y-auto">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-lg">Filters</h2>
        <label for="filter-drawer" class="btn btn-ghost btn-sm btn-square" aria-label="Close">✕</label>
      </div>
      <%= form_with url: account_path(@account), method: :get, class: "space-y-3" do %>
        <div class="fieldset">
          <label class="label text-xs">Search</label>
          <%= search_field_tag :q, params[:q], placeholder: "Payee contains…", class: "input input-sm w-full" %>
        </div>
        <label class="label cursor-pointer gap-1.5 text-sm">
          <%= check_box_tag :uncategorised, 1, params[:uncategorised].present?, class: "checkbox checkbox-sm" %>
          Uncategorised only
        </label>
        <div class="flex gap-2">
          <%= submit_tag "Apply", class: "btn btn-primary btn-sm flex-1" %>
          <%= link_to "Clear", account_path(@account), class: "btn btn-ghost btn-sm" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
